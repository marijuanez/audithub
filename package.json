{
  "name": "audithub",
  "version": "1.0.0",
  "private": true,
  "description": "AuditHub — Centro de Control y Estado de Webs",
  "scripts": {
    "create-project": "npx -y firebase-tools@latest projects:create audithub-marijuanez --display-name AuditHub",
    "create-site": "npx -y firebase-tools@latest hosting:sites:create audithub --project audithub-marijuanez",
    "create-site-auditkit": "npx -y firebase-tools@latest hosting:sites:create auditkit --project audithub-marijuanez",
    "deploy": "npx -y firebase-tools@latest deploy --only hosting --project audithub-marijuanez",
    "projects-list": "npx -y firebase-tools@latest projects:list"
  }
}
